{
  "name": "luma-x-library",
  "version": "0.5.1-beta.1",
  "private": true,
  "description": "Local X photo library",
  "author": "Luu",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win portable nsis",
    "test": ".venv/Scripts/python -m unittest discover -s tests -v",
    "test:desktop": "electron tests/redesign-smoke.cjs",
    "test:power": "node --test tests/completion.test.cjs",
    "test:profile": "node --test tests/profile.test.cjs",
    "test:assistant": "node --test tests/assistant.test.cjs",
    "test:assistant:desktop": "electron tests/assistant-smoke.cjs",
    "test:redesign": "electron tests/redesign-smoke.cjs"
  },
  "dependencies": {
    "flag-icons": "7.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "studio.luu.luma",
    "productName": "Luma",
    "directories": {
      "output": "release-public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "locales/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/luma-backend",
        "to": "backend"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "tools/luma_assistant.py",
        "to": "assistant/luma_assistant.py"
      },
      {
        "from": "docs/LOCAL_ASSISTANT.md",
        "to": "assistant/README.md"
      },
      {
        "from": "collector-dist/luma-collector",
        "to": "collector"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs/PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "docs/SOURCE_CODE.md",
        "to": "SOURCE_CODE.md"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build-resources/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Luma-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Luma-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "compression": "normal"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/syflu81890-max/Luma.git"
  }
}
